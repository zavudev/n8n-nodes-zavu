{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2019",
    "lib": ["es2019", "es2020", "es2022.error", "dom"],
    "removeComments": true,
    "useUnknownInCatchVariables": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "preserveConstEnums": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "incremental": true,
    // Outside dist/ on purpose: dist/ is what npm publishes, and the build cache
    // is 77kB of noise in the tarball.
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "types": ["node"],
    "outDir": "./dist/",
    "rootDir": "./"
  },
  "include": ["credentials/**/*", "nodes/**/*", "package.json"],
  "exclude": ["dist/**/*", "node_modules/**/*"]
}
